# Backend API URL for server-side proxy
API_URL=http://localhost:8000

# Telegram bot username for client-side login widget (required at build time in Docker)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=zeta_auth_bot

# Enable dev login button for testing without Telegram widget (default: false)
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false

# Optional server configuration
PORT=3000
HOSTNAME=0.0.0.0
