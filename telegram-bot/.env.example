# Telegram Bot API token from @BotFather (required)
BOT_TOKEN=your_telegram_bot_token_here

# Base URL of Zeta FastAPI Backend (default: http://localhost:8000)
BACKEND_BASE_URL=http://localhost:8000

# Base URL of Zeta Web Application for login widget & web redirects (default: http://localhost:3000)
WEB_APP_URL=http://localhost:3000

# Long polling timeout in seconds (default: 30)
POLLING_TIMEOUT=30

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Optional Cloudflare / HTTP proxy URL for Telegram Bot API requests
# TELEGRAM_PROXY_URL=https://proxy.example.com
